# Stream Chat - Environment Configuration
# Copy this file to .env and fill in the values.
#
# NOTE: JWT_SECRET is mandatory. Generate a strong, unique value (>= 32 bytes);
# the app refuses to start if it is missing, too short, or a known insecure
# default when running under the prod/docker profiles.

# ==========================================
# Application Settings
# ==========================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=jdbc:postgresql://postgres:5432/stream_chat_db
DATABASE_USERNAME=stream_chat_user
DATABASE_PASSWORD=stream_chat_pass
POSTGRES_DB=stream_chat_db
POSTGRES_USER=stream_chat_user
POSTGRES_PASSWORD=stream_chat_pass

# ==========================================
# Redis
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT Authentication
# ==========================================
# Mandatory: generate a strong, unique secret (>= 32 bytes). Example:
#   openssl rand -base64 48
# The app refuses to boot if it is missing, too short, or a known insecure
# default when running under the prod/docker profiles.
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# ==========================================
# CORS (comma-separated origins)
# ==========================================
# Required in prod/docker: explicit origins only, never '*'.
# Example: https://streamchat.example.com
APP_CORS_ALLOWED_ORIGINS=

# ==========================================
# Chat Settings
# ==========================================
CHAT_RETENTION_DAYS=90

# ==========================================
# AutoMod Configuration
# ==========================================
AUTOMOD_CAPS_THRESHOLD=0.7
AUTOMOD_SPAM_SCORE_THRESHOLD=3
AUTOMOD_TRUST_DECAY_RATE=0.1
AUTOMOD_SHADOW_BAN_ENABLED=true

# ==========================================
# Logging
# ==========================================
# Set to 'JSON' for production structured logging
LOG_FORMAT=TEXT
