# Stream Chat - Environment Configuration
# Copy this file to .env and fill in the values

# ==========================================
# Application Settings
# ==========================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=jdbc:postgresql://postgres:5432/stream_chat_db
DATABASE_USERNAME=stream_chat_user
DATABASE_PASSWORD=
POSTGRES_USER=stream_chat_user
POSTGRES_PASSWORD=

# ==========================================
# Redis
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT Authentication
# ==========================================
# REQUIRED. Generate with: openssl rand -base64 48
# Must be at least 32 bytes (256 bits); the app refuses to start otherwise.
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# ==========================================
# CORS (comma-separated origins)
# ==========================================
CORS_ALLOWED_ORIGINS=

# ==========================================
# Chat Settings
# ==========================================
CHAT_RETENTION_DAYS=90

# ==========================================
# AutoMod Configuration
# ==========================================
AUTOMOD_CAPS_THRESHOLD=0.7
AUTOMOD_SPAM_SCORE_THRESHOLD=3
AUTOMOD_TRUST_DECAY_RATE=0.1
AUTOMOD_SHADOW_BAN_ENABLED=true

# ==========================================
# Logging
# ==========================================
# Set to 'JSON' for production structured logging
LOG_FORMAT=TEXT
