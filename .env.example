# Stream Chat - Environment Configuration
# Copy this file to .env and fill in the values.
#
# NOTE: for a LOCAL TEST RUN, `docker compose up --build -d` works with NO
# .env at all — every variable below has a DEV-ONLY default baked into
# docker-compose.yml (including JWT_SECRET, so openssl is not needed).
# Override these values for anything shared or deployed.

# ==========================================
# Application Settings
# ==========================================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ==========================================
# Database (PostgreSQL)
# ==========================================
DATABASE_URL=jdbc:postgresql://postgres:5432/stream_chat_db
DATABASE_USERNAME=stream_chat_user
DATABASE_PASSWORD=stream_chat_pass
POSTGRES_DB=stream_chat_db
POSTGRES_USER=stream_chat_user
POSTGRES_PASSWORD=stream_chat_pass

# ==========================================
# Redis
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ==========================================
# JWT Authentication
# ==========================================
# DEV default in compose is "dev-secret-key-please-change-in-production-must-be-at-least-64-characters-long"
# (>= 32 bytes; the app refuses to start otherwise). For anything shared or
# deployed, generate a real one — on Windows: [Convert]::ToBase64String((1..48 | % { Get-Random -Min 0 -Max 256 }))
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P30D

# ==========================================
# CORS (comma-separated origins)
# ==========================================
# Default: http://localhost:3000,http://localhost:8080
CORS_ALLOWED_ORIGINS=

# ==========================================
# Chat Settings
# ==========================================
CHAT_RETENTION_DAYS=90

# ==========================================
# AutoMod Configuration
# ==========================================
AUTOMOD_CAPS_THRESHOLD=0.7
AUTOMOD_SPAM_SCORE_THRESHOLD=3
AUTOMOD_TRUST_DECAY_RATE=0.1
AUTOMOD_SHADOW_BAN_ENABLED=true

# ==========================================
# Logging
# ==========================================
# Set to 'JSON' for production structured logging
LOG_FORMAT=TEXT
