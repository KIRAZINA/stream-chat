# Vite Environment Variables
# These are loaded into import.meta.env

# Backend API URL (used for proxies in Vite dev server)
VITE_API_URL=http://localhost:8080

# WebSocket URL for STOMP connection (used in StreamStompClient)
# If unset, the client will attempt to derive from window.location.protocol/host
# (e.g., ws://localhost:8080/ws-chat when running on the same host as the backend).
# Only throw if both VITE_WS_URL and window.location are unavailable (e.g., SSR).
VITE_WS_URL=ws://localhost:8080/ws-chat
